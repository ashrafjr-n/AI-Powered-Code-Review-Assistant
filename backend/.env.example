# Local Docker Postgres (see ../docker-compose.yml, host port 5433).
# User, password and DB name must match the root .env
DATABASE_URL="postgresql://codereview:change-me@localhost:5433/codereview?schema=public"

# Secret for signing login tokens (JWT). Make one with: openssl rand -hex 32
JWT_SECRET="change-me"

# Optional, default 4000
# PORT=4000

# Set to "production" on a hosted server (hosts like Render set it for you):
# the login cookie is then sent over HTTPS only (Secure flag).
# NODE_ENV=production

# Encrypts stored AI provider API keys (AES-256-GCM). Make one with: openssl rand -hex 32
# Changing it makes already stored keys unreadable (users re-enter them).
ENCRYPTION_KEY="change-me-64-hex-characters"

# true = allow providers on localhost / private networks (LM Studio, Ollama).
# Local development only. Leave unset on a hosted server (SSRF protection).
ALLOW_LOCAL_PROVIDERS=true

# Built-in demo model: people can try Redline before adding their own key.
# Leave DEMO_BASE_URL empty to turn the demo off. Any OpenAI-compatible API works.
# Free option: Google Gemini (key from https://aistudio.google.com/apikey).
DEMO_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
DEMO_MODEL="gemini-3.5-flash-lite"
DEMO_API_KEY=""
DEMO_NAME="Redline demo"
DEMO_DAILY_LIMIT_PER_USER=10
DEMO_DAILY_LIMIT_TOTAL=200

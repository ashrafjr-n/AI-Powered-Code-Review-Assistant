// Prisma schema: https://pris.ly/d/prisma-schema
// Ownership chain: User -> Project -> (File | Review | ChatSession -> Message).
// Reviews and chats reach their owner through the project, so no duplicated userId.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReviewMode {
  SECURITY
  PERFORMANCE
  QUALITY
}

enum ReviewScope {
  FILE
  FILES
  PROJECT
  DIFF // two files compared: filePaths = [before, after]
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum InsightKind {
  ARCHITECTURE
  README
  SETUP
  API_DOCS
}

enum MessageRole {
  USER
  ASSISTANT
}

model User {
  id           String       @id @default(uuid(7)) @db.Uuid
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  projects     Project[]
  aiProviders  AiProvider[]
  demoUsage    DemoUsage[]
}

model Project {
  id           String        @id @default(uuid(7)) @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String        @default("")
  uploadStats  Json? // last upload: kept / skipped counts by reason / redacted secrets
  codeVersion  Int           @default(0) // +1 on every upload; reviews/docs store the version they read
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  files        File[]
  reviews      Review[]
  chatSessions ChatSession[]
  insights     Insight[]

  @@index([userId, createdAt])
}

model File {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String // relative path inside the upload, e.g. "src/app.ts"
  content   String   @db.Text // "" for sensitive files; secrets in code are ‹redacted›
  size      Int // bytes, so file lists never need to load content
  sensitive Boolean  @default(false) // env/key/credential file: kept by path only
  createdAt DateTime @default(now())

  @@unique([projectId, path])
}

model Review {
  id              String      @id @default(uuid(7)) @db.Uuid
  projectId       String      @db.Uuid
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mode            ReviewMode
  scope           ReviewScope
  filePaths       String[] // files actually sent to the AI
  diff            String?     @db.Text // DIFF only: the unified diff that was reviewed (kept after re-uploads)
  codeVersion     Int         @default(0) // Project.codeVersion when the files were read
  summary         String      @db.Text
  issues          Json // [{ title, description, severity, filePath?, line? }] validated with Zod
  recommendations Json // string[] validated with Zod
  highestSeverity Severity? // null when no issues; stored for list badges and filtering
  providerName    String // snapshot, so history survives provider edits/deletes
  model           String
  createdAt       DateTime    @default(now())

  @@index([projectId, createdAt])
}

model AiProvider {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String // e.g. "OpenAI", "LM Studio"
  baseUrl         String // e.g. https://api.openai.com/v1
  model           String
  apiKeyEncrypted String? // AES-256-GCM; null for local servers without a key
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model ChatSession {
  id        String    @id @default(uuid(7)) @db.Uuid
  projectId String    @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime  @default(now())
  messages  Message[]

  @@index([projectId, createdAt])
}

model Message {
  id        String      @id @default(uuid(7)) @db.Uuid
  sessionId String      @db.Uuid
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String      @db.Text
  sources   String[]    @default([]) // files the assistant used as context (keyword retrieval)
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// Requests a user made today with the built-in demo model (server-side key, daily limits).
// The site-wide total is the sum of all rows of one day.
model DemoUsage {
  userId String   @db.Uuid
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date // UTC day
  count  Int      @default(0)

  @@id([userId, day])
  @@index([day])
}

// Generated architecture overview / docs. One per project and kind: regenerating replaces it.
model Insight {
  id           String      @id @default(uuid(7)) @db.Uuid
  projectId    String      @db.Uuid
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         InsightKind
  content      String      @db.Text
  filePaths    String[] // files the model read
  codeVersion  Int         @default(0) // Project.codeVersion when the files were read
  providerName String // snapshot, like reviews
  model        String
  createdAt    DateTime    @default(now())

  @@unique([projectId, kind])
}
